{
  "manifestVersion": 2,
  "extensionApiVersion": 1,
  "name": "camera",
  "displayName": "Camera",
  "version": "1.0.0",
  "description": "Camera manager, live preview window, and image blocks.",
  "permissions": ["camera"],
  "pythonDependencies": {
    "blockly": ["opencv-python>=4.8"]
  },
  "contributes": {
    "backend": {
      "main": "backend/main.py"
    },
    "blocks": {
      "category": "Camera",
      "colour": "#4B8BBE",
      "files": ["blocks/blocks.json"]
    },
    "dynamicFields": {
      "devices": {
        "kind": "httpOptions",
        "path": "/cameras",
        "refreshPath": "/cameras?refresh=1",
        "itemsKey": "cameras",
        "labelKey": "name",
        "valueKey": "id",
        "refresh": "onOpen",
        "cacheMs": 20000
      }
    },
    "runtime": {
      "python": "runtime/adapter.py"
    },
    "window": {
      "title": "Camera",
      "html": "frontend/window.html",
      "js": "frontend/window.js",
      "css": "frontend/window.css"
    }
  }
}
