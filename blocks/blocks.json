[
  {
    "type": "camera_setup",
    "message0": "setup camera %1 as %2",
    "args0": [
      {
        "type": "field_dropdown",
        "name": "CAMERA",
        "options": [["Choose camera", ""]],
        "source": "devices"
      },
      {
        "type": "field_variable",
        "name": "CAP",
        "variable": "cap"
      }
    ],
    "previousStatement": null,
    "nextStatement": null,
    "colour": 200,
    "tooltip": "Open this camera once. Capture blocks read from the variable.",
    "hardware": true,
    "studiox": {
      "python": "{CAP} = __studiox_extensions['camera'].open_camera({CAMERA})\n"
    },
    "portable": {
      "imports": ["import cv2"],
      "python": "{CAP} = cv2.VideoCapture({CAMERA})\n",
      "cleanup": "{CAP}.release()"
    },
    "simulation": {
      "python": "{CAP} = __studiox_simulation_placeholder('camera', 'open_camera', {CAMERA})\n"
    }
  },
  {
    "type": "camera_capture",
    "message0": "capture from %1",
    "args0": [
      {
        "type": "field_variable",
        "name": "CAP",
        "variable": "cap"
      }
    ],
    "output": null,
    "colour": 200,
    "tooltip": "Read one frame from a camera opened by setup camera.",
    "pythonImports": ["import cv2"],
    "python": "{CAP}.read()[1]"
  },
  {
    "type": "camera_resize",
    "message0": "resize %1 to %2 × %3",
    "args0": [
      { "type": "input_value", "name": "IMAGE" },
      { "type": "field_number", "name": "WIDTH", "value": 1024, "min": 1, "max": 4096, "precision": 1 },
      { "type": "field_number", "name": "HEIGHT", "value": 1024, "min": 1, "max": 4096, "precision": 1 }
    ],
    "output": null,
    "colour": 200,
    "tooltip": "Resize an image to a width and height.",
    "pythonImports": ["import cv2"],
    "python": "cv2.resize({IMAGE}, ({WIDTH}, {HEIGHT}))",
    "simulation": {
      "python": "__studiox_simulation_note('Camera resize is not applied during simulation', {IMAGE})"
    }
  },
  {
    "type": "camera_convert",
    "message0": "convert %1 to %2",
    "args0": [
      { "type": "input_value", "name": "IMAGE" },
      {
        "type": "field_dropdown",
        "name": "MODE",
        "options": [
          ["Gray", "GRAY"],
          ["RGB", "RGB"],
          ["BGR", "BGR"],
          ["HSV", "HSV"]
        ],
        "unquoted": true
      }
    ],
    "output": null,
    "colour": 200,
    "tooltip": "Convert an image to RGB, BGR, gray, or HSV.",
    "pythonImports": ["import cv2"],
    "simulation": {
      "python": "__studiox_simulation_note('Camera color conversion is not applied during simulation', {IMAGE})"
    },
    "python": {
      "select": {
        "field": "MODE",
        "cases": {
          "BGR": "{IMAGE}"
        },
        "default": "cv2.cvtColor({IMAGE}, cv2.COLOR_BGR2{MODE})"
      }
    }
  },
  {
    "type": "camera_preview",
    "message0": "preview %1 in slot %2",
    "args0": [
      { "type": "input_value", "name": "IMAGE" },
      { "type": "field_number", "name": "SLOT", "value": 1, "min": 1, "max": 12, "precision": 1 }
    ],
    "previousStatement": null,
    "nextStatement": null,
    "colour": 200,
    "tooltip": "Show this frame in the Camera preview tab. This block does not add Python.",
    "codegen": "debug",
    "pythonHidden": true,
    "python": "__studiox_preview({IMAGE}, {SLOT})\n"
  }
]
